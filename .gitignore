# Dependencies and build output are reproducible from package-lock.json and the
# sources. node_modules in particular was committed once — 6,845 files, with
# Windows .cmd shims that are not executable on macOS — which is why a fresh
# `npm test` on another machine failed with "Permission denied" rather than
# running. Reinstall instead of syncing it.
node_modules/
dist/

# Vite / vitest
.vite/
coverage/

# Scanner working files. `build/` is regenerated by tools/scan.py; the catalogue
# it produces (src/catalog/catalog.json) IS committed, on purpose — the app has
# to work without Python.
__pycache__/
*.pyc

# Agent scratch. `.claude/worktrees/` holds live git worktrees for background
# tasks — a whole second checkout of this repo, `.git` pointer and all — so
# committing it would nest the repo inside itself. The config beside it
# (launch.json, commands/) IS committed: it is project setup, not session state.
.claude/worktrees/

# OS noise
.DS_Store
Thumbs.db
